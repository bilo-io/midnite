        "sinceHours": {
          "label": "Since (hours)",
          "help": "How far back to look. Default 24."
        },
        "repo": {
          "label": "Repo",
          "help": "Optional: only this repo."
        },
        "projectId": {
          "label": "Project",
          "help": "Optional: only this project."
        }
      }
    },
